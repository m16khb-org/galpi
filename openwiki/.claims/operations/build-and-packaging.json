    {
      "id": "claim_2180a807d4eb41a2bffb88aeb1a82e5c",
      "statement": "Signing and notarization secrets are optional in release.yml: the certificate import step runs only when APPLE_CERTIFICATE is non-empty, and the build step exports APPLE_SIGNING_IDENTITY/APPLE_ID/APPLE_PASSWORD/APPLE_TEAM_ID which are empty when absent — leaving Tauri on its configured ad-hoc signingIdentity '-' and producing an ad-hoc signed DMG suitable for internal testing only.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release.yml#L26-L43",
          "version": "repo-lines-v1:sha256:e623ed4c3a8aae817a88329f79bf7439c5efab734e60c803254e6b076be78a3b:"
